<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>보고서 동반 가이드 · {{ alias }}</title>
<style>
  :root {
    --ink: #2f3437; --sub: #6b7280; --line: #e5e2dc; --bg: #f7f6f3;
    --card: #ffffff; --accent: #4a6fa5; --warm: #b0552e;
    --chip-normal: #eef2ec; --chip-normal-ink: #4f6b52;
    --chip-borderline: #f8ecd9; --chip-borderline-ink: #8a6425;
    --chip-clinical: #f6e0d8; --chip-clinical-ink: #97462a;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink);
         font-family: "Apple SD Gothic Neo", "Noto Sans KR", "Malgun Gothic", sans-serif;
         line-height: 1.6; font-size: 15px; }
  main { max-width: 840px; margin: 0 auto; padding: 24px 16px 56px; }
  h1 { font-size: 22px; margin: 0 0 6px; }
  h2 { font-size: 18px; margin: 0 0 12px; padding-bottom: 6px; border-bottom: 2px solid var(--ink); }
  h3 { font-size: 15px; margin: 0 0 8px; }
  p { margin: 0 0 10px; }
  details.meta { color: var(--sub); font-size: 12.5px; margin-bottom: 14px; }
  details.meta summary { cursor: pointer; list-style: none; }
  details.meta summary::-webkit-details-marker { display: none; }
  .badge { display: inline-block; background: var(--chip-borderline); color: var(--chip-borderline-ink);
           border-radius: 20px; padding: 1px 10px; font-weight: 600; margin-right: 6px; }
  .jump { display: inline-block; background: var(--accent); color: #fff; text-decoration: none; font-weight: 700;
          border-radius: 8px; padding: 10px 16px; margin: 4px 0 18px; font-size: 14.5px; }
  .jump small { font-weight: 400; opacity: .85; margin-left: 6px; }
  section.page { background: var(--card); border: 1px solid var(--line); border-radius: 12px;
                 padding: 22px 20px 18px; margin-bottom: 18px; }
  blockquote.lens { margin: 0 0 14px; padding: 12px 16px; border-left: 4px solid var(--accent);
                    background: #f2f5f9; border-radius: 0 8px 8px 0; font-size: 15px; }
  figure { margin: 0 0 12px; }
  figcaption { color: var(--sub); font-size: 12.5px; margin-top: 2px; }
  .box { border: 1px solid var(--line); border-radius: 8px; padding: 10px 14px; margin-bottom: 12px; }
  .box.gen { background: #fbfaf7; }
  .box p:last-child { margin-bottom: 0; }
  .howto figure { margin: 4px 0 8px; }
  .howto svg { display: block; max-width: 560px; margin: 0 auto; }
  .howto figcaption { color: var(--ink); font-size: 13.5px; font-weight: 400; text-align: center; margin-top: 2px; }
  .howto p { color: var(--sub); font-size: 13.5px; margin: 0 0 4px; }
  .tag { display: inline-block; font-size: 11px; color: var(--sub); border: 1px solid var(--line);
         border-radius: 4px; padding: 0 6px; margin-left: 6px; vertical-align: 1px; font-weight: 400; }
  .tag.fb { background: #eee; }
  .tag.pending { color: var(--accent); border-color: var(--accent); border-style: dashed; }
  .pending-text { color: var(--sub); font-style: italic; }
  details.fold { color: var(--sub); font-size: 12.5px; border-top: 1px dashed var(--line); padding-top: 8px; margin-top: 8px; }
  details.fold summary { cursor: pointer; }
  details.fold ol { margin: 6px 0 0; padding-left: 18px; }
  .hier-note { color: var(--sub); font-size: 13px; margin: 0 0 12px; }
  .chip { display: inline-block; font-size: 12px; font-weight: 700; border-radius: 20px; padding: 1px 10px; }
  .chip.normal { background: var(--chip-normal); color: var(--chip-normal-ink); }
  .chip.borderline { background: var(--chip-borderline); color: var(--chip-borderline-ink); }
  .chip.clinical { background: var(--chip-clinical); color: var(--chip-clinical-ink); }
  .row { border: 1px solid var(--line); border-radius: 10px; padding: 10px 14px 8px; margin-bottom: 8px; }
  /* 카드 헤더: 척도명 + 한 문장 결론 (좁으면 결론이 다음 줄로), 그 아래 쉬운 구간 · 라벨 배지 · 수치 */
  .row .head, .card .head { display: flex; align-items: baseline; gap: 2px 10px; flex-wrap: wrap; }
  .verdict { font-size: 15px; }
  .range { color: var(--sub); font-size: 13px; margin: 2px 0 0; }
  .range .chip { font-size: 11.5px; padding: 0 8px; vertical-align: 1px; }
  .range-inline { color: var(--sub); font-size: 13px; font-weight: 400; margin-left: 6px; white-space: nowrap; }
  .range-inline .chip { font-size: 11.5px; padding: 0 8px; vertical-align: 1px; }
  .card { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px 8px; margin-bottom: 10px; }
  .card.open { border-color: var(--chip-borderline-ink); }
  details.card summary { cursor: pointer; list-style: none; }
  details.card summary::-webkit-details-marker { display: none; }
  details.card summary .head::after { content: "펼치기"; color: var(--accent); font-size: 12px; margin-left: auto; }
  details.card[open] summary .head::after { content: "접기"; }
  .card svg, .row svg { margin-top: 8px; }
  .card .text, .row .text { margin: 6px 0 4px; }
  .nodx { color: var(--sub); font-size: 12.5px; margin: 0 0 4px; }
  .psyedu { color: var(--sub); font-size: 12.5px; background: #fbfaf7; border: 1px dashed var(--line);
            border-radius: 8px; padding: 6px 10px; margin: 6px 0; }
  .caution { border: 1px solid var(--chip-clinical-ink); border-radius: 8px; padding: 10px 14px;
             margin: 14px 0 8px; font-size: 14px; }
  ul.qlist { list-style: none; margin: 0; padding: 0; }
  ul.qlist li { display: flex; gap: 10px; align-items: flex-start; border-bottom: 1px dashed var(--line);
                padding: 8px 2px; }
  ul.qlist input { margin-top: 5px; }
  .src-badge { font-size: 11.5px; color: var(--accent); white-space: nowrap; margin-left: auto; padding-left: 10px; }
  details.brief { margin-top: 14px; }
  details.brief summary { cursor: pointer; font-weight: 700; font-size: 14px; }
  details.brief .box { margin-top: 8px; }
  footer { color: var(--sub); font-size: 12.5px; text-align: center; margin-top: 8px; }
  footer summary { cursor: pointer; }
  @media print { section.page { break-after: page; border: none; } details { open: true; } }
</style>
</head>
<body>
<main>
  <header>
    <h1>보고서 동반 가이드</h1>
    <details class="meta">
      <summary><span class="badge">자작 가상 데이터</span>{{ alias }} (가상 아동) · 검사일 {{ test_date }} · 자세히</summary>
      {{ instrument }} · 생성 모드 {{ mode_label }}{% if model_label %} · 모델 {{ model_label }}{% endif %}
      {% if pending %}· 생성 전 (결정론 부분만 렌더){% else %}· 가드레일 재생성 {{ regen_count }}회 · 안전 문구 대체 {{ fallback_count }}건{% endif %}
    </details>
    <a class="jump" href="#prep">상담사에게 물어볼 질문 보기 <small>↓ {% if pending %}생성 대기{% else %}{{ questions|length }}개{% endif %} · 상담까지 {{ days }}일</small></a>
  </header>

  <section class="page" id="page1">
    <h2>1페이지 · 결과를 읽기 전에: 관찰자의 렌즈</h2>
    <blockquote class="lens">{{ lens_quote }}</blockquote>
    <figure>
      {{ concept_svg|safe }}
      <figcaption>같은 아이라도 관찰자(보호자, 교사)에 따라 결과가 다르게 나타나는 전형적인 모습 — 개념 예시입니다.</figcaption>
    </figure>
    <div class="box howto" id="howto">
      <h3>곡선 읽는 법 <span class="tag">고정 문구</span></h3>
      <figure>
        {{ explainer_svg|safe }}
        <figcaption>{{ curve_howto_caption }}</figcaption>
      </figure>
      {% for line in curve_howto_lines %}<p>{{ line }}</p>{% endfor %}
    </div>
    <div class="box">
      <h3>T점수란 <span class="tag">고정 문구</span></h3>
      <p>{{ tscore_explain }}</p>
    </div>
    <details class="fold">
      <summary>{{ footnotes_summary }} 근거 보기</summary>
      <ol>
        {% for note in footnotes %}<li>{{ note }}</li>{% endfor %}
      </ol>
    </details>
  </section>

  <section class="page" id="page2">
    <h2>2페이지 · 우리 아이 결과</h2>
    <p class="hier-note">읽는 순서: ① 총 문제행동 → ② 내재화/외현화 → ③ 개별 척도.
      {% if elevated_names %}상담에서 함께 살펴볼 영역: {{ elevated_names|join(", ") }}.{% else %}모든 척도가 정상 범위로 보고되었습니다.{% endif %}</p>

    <div class="box gen">
      <h3>보호자의 관찰과 검사 소견{% if pending %}<span class="tag pending">생성 대기</span>{% elif overview_fallback %}<span class="tag fb">안전 문구로 대체됨</span>{% else %}<span class="tag">생성 문구 · 검증 통과</span>{% endif %}</h3>
      <p{% if pending %} class="pending-text"{% endif %}>{{ overview }}</p>
    </div>

    <h3>종합지표</h3>
    {% for c in composites %}
    <div class="row" id="scale-{{ c.id }}">
      <div class="head">
        <strong>{{ loop.index }}. {{ c.name }}</strong>
        <span class="verdict">{{ c.verdict }}</span>
        {% if c.band == "normal" %}<span class="range-inline">· <span class="chip {{ c.band }}">{{ c.band_ko }}</span> · {{ c.t }}T</span>{% endif %}
      </div>
      {% if c.band != "normal" %}<p class="range">보고서 표기 <span class="chip {{ c.band }}">{{ c.band_ko }}</span> · 이번 검사 결과 {{ c.t }}T</p>{% endif %}
      {% if c.open %}
      {{ c.svg|safe }}
      <p class="text">{{ c.text }} <span class="tag">고정 문구</span></p>
      <p class="nodx">{{ not_diagnosis }}</p>
      {% endif %}
    </div>
    {% endfor %}

    <h3 style="margin-top:16px">개별 척도</h3>
    {% for s in syndromes %}
    <details class="card{% if s.open %} open{% endif %}" id="scale-{{ s.id }}"{% if s.open %} open{% endif %}>
      <summary>
        <div class="head">
          <strong>{{ s.name }}</strong>
          <span class="verdict">{{ s.verdict }}</span>
          {% if s.band == "normal" %}<span class="range-inline">· <span class="chip {{ s.band }}">{{ s.band_ko }}</span> · {{ s.t }}T</span>{% endif %}
        </div>
        {% if s.band != "normal" %}<p class="range">보고서 표기 <span class="chip {{ s.band }}">{{ s.band_ko }}</span> · 이번 검사 결과 {{ s.t }}T</p>{% endif %}
      </summary>
      {{ s.svg|safe }}
      <p class="text">{{ s.text }} <span class="tag">고정 문구</span></p>
      {% if s.band != "normal" %}<p class="nodx">{{ not_diagnosis }}</p>{% endif %}
    </details>
    {% endfor %}
    {% if has_borderline %}<div class="psyedu">{{ borderline_note }}</div>{% endif %}

    <details class="fold">
      <summary>곡선의 색 구간, 오차 범위선, 기준선은 무엇인가요</summary>
      <p style="margin-top:6px">{{ sem_note }}</p>
    </details>

    <div class="caution">{{ caution }}</div>
    <details class="fold">
      <summary>이 자료의 한계 (고정 문구)</summary>
      <p style="margin-top:6px">{{ limits }}</p>
    </details>
  </section>

  <section class="page" id="prep">
    <h2>상담 준비 도우미</h2>
    <h3>{{ pre_counseling_label }} <span class="tag">고정 문구</span></h3>
    <p>{{ pre_counseling_note }}</p>

    <h3 style="margin-top:16px">상담사에게 물어볼 질문 <span class="tag">체크한 질문이 상담사에게 전달됩니다</span></h3>
    <ul class="qlist">
      {% for q in questions %}
      <li><input type="checkbox" checked> <span{% if q.pending %} class="pending-text"{% endif %}>{{ q.text }}{% if q.pending %}<span class="tag pending">생성 대기</span>{% elif q.fallback %}<span class="tag fb">안전 문구</span>{% endif %}</span>
          {% if not q.pending %}<span class="src-badge">근거: {{ q.source_name }}</span>{% endif %}</li>
      {% endfor %}
    </ul>

    <h3 style="margin-top:16px">상담까지 남은 {{ days }}일, 가정 관찰 포인트</h3>
    <ul class="qlist">
      {% for o in observations %}
      <li><span>·</span> <span{% if o.pending %} class="pending-text"{% endif %}>{{ o.text }}{% if o.pending %}<span class="tag pending">생성 대기</span>{% elif o.fallback %}<span class="tag fb">안전 문구</span>{% endif %}</span>
          {% if not o.pending %}<span class="src-badge">근거: {{ o.source_name }}</span>{% endif %}</li>
      {% endfor %}
    </ul>

    <details class="brief">
      <summary>상담사용 사전 요약 (보호자 화면에는 표시되지 않는 별도 전달용){% if pending %}<span class="tag pending">생성 대기</span>{% elif briefing_fallback %}<span class="tag fb">안전 문구로 대체됨</span>{% endif %}</summary>
      <div class="box gen{% if pending %} pending-text{% endif %}">{{ briefing }}</div>
    </details>
  </section>

  <footer>
    <details>
      <summary>생성 정보</summary>
      {% if pending %}생성 전 미리보기 (LLM 미호출){% else %}가드레일 재생성 {{ regen_count }}회 · 안전 문구 대체 {{ fallback_count }}건{% endif %} ·
      수치와 그림은 결정론 코드가, 연결 문단·질문은 LLM이, 척도 해설과 상담 전 안내는 고정 문구가, 임상 판단은 상담사가 담당합니다.
    </details>
  </footer>
</main>
<script data-inpage-jump>
// 이 리포트가 srcdoc iframe(예: Streamlit 탐색 콘솔) 안에서 열리면 "#prep" 같은 문서 내 링크가
// 부모 페이지 URL 기준으로 해석되어 iframe 안에 부모 앱이 다시 열린다 (srcdoc 문서는 부모의 base URL을 물려받음).
// 문서 내 이동은 스크립트로 직접 처리해 단독 파일과 iframe 양쪽에서 같은 동작을 보장한다.
document.addEventListener('click', function (e) {
  var a = e.target.closest('a[href^="#"]');
  if (!a) return;
  var t = document.getElementById(a.getAttribute('href').slice(1));
  if (!t) return;
  e.preventDefault();
  t.scrollIntoView({ block: 'start' }); // 즉시 이동: 숨은 탭·감속 모션 설정에서도 확실히 동작
});
</script>
</body>
</html>
