# OpenAI 호환 엔드포인트. 기본은 OpenAI(gpt-5.6-luna). Ollama 로컬로 바꾸려면:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=gemma4:12b      (api_key는 아무 값이나 가능. 비교군 qwen3.8:27b)
#   LLM_NUM_CTX=8192          (Ollama 전용. 지정하면 네이티브 /api/chat로 호출해 컨텍스트 길이를 고정)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-5.6-luna
# 사고(thinking) 강도. 구조화 JSON 생성 작업이라 기본 none (지연·비용 절감, Ollama gemma4는
# 켜 두면 사고 토큰이 응답 예산을 먹어 빈 응답이 날 수 있음). 빈 값이면 파라미터를 보내지 않음.
LLM_REASONING_EFFORT=none
# 호출 1건 상한(초). 로컬 8~12B 모델은 재생성 포함 건당 수 분이라 기본 180
LLM_TIMEOUT_S=180
